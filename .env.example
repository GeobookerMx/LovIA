# ── Supabase (Frontend — safe to expose) ──
VITE_APP_ENV=development
VITE_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
VITE_SUPABASE_EXPECTED_REF=YOUR_TEST_PROJECT
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_TEST_PUBLISHABLE_OR_ANON_KEY
VITE_DEV_BYPASS=false
VITE_HALLOWEEN_2026=true
VITE_ENABLE_PAID_CHECKOUT=false
VITE_ENABLE_RADAR=false
# URL HTTPS autorizada en Supabase Auth para recuperación desde la app nativa.
VITE_RECOVERY_WEB_ORIGIN=

# ── Stripe (Frontend — publishable key only) ──
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# ── NEVER put these in frontend ──
# STRIPE_SECRET_KEY → only in Supabase Edge Functions
# SUPABASE_SERVICE_ROLE_KEY → only in server-side code
