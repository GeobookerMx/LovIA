# Copy to .env.staging.local or configure the Netlify staging context.
VITE_APP_ENV=staging
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
VITE_SUPABASE_EXPECTED_REF=YOUR_STAGING_PROJECT
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_STAGING_PUBLISHABLE_OR_ANON_KEY
VITE_DEV_BYPASS=false
VITE_HALLOWEEN_2026=true
VITE_ENABLE_PAID_CHECKOUT=false
VITE_ENABLE_RADAR=false
VITE_RECOVERY_WEB_ORIGIN=
